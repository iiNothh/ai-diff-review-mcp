{
  "name": "difference-mcp",
  "displayName": "Difference MCP",
  "description": "MCP server for AI agents with interactive diff Accept/Reject workflow",
  "version": "0.1.0",
  "publisher": "DifferenceMCP",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-diff-review",
          "title": "AI Diff Review",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-diff-review": [
        {
          "id": "pendingAiChanges",
          "name": "Pending AI Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-diff-mcp.accept",
        "title": "Accept AI Change",
        "icon": "$(check)"
      },
      {
        "command": "vscode-diff-mcp.reject",
        "title": "Reject AI Change",
        "icon": "$(x)"
      },
      {
        "command": "vscode-diff-mcp.acceptAll",
        "title": "Accept All AI Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "vscode-diff-mcp.rejectAll",
        "title": "Reject All AI Changes",
        "icon": "$(close-all)"
      },
      {
        "command": "vscode-diff-mcp.openDiff",
        "title": "View Diff",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-diff-mcp.acceptAll",
          "when": "view == pendingAiChanges",
          "group": "navigation"
        },
        {
          "command": "vscode-diff-mcp.rejectAll",
          "when": "view == pendingAiChanges",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-diff-mcp.accept",
          "when": "view == pendingAiChanges && viewItem == pendingChange",
          "group": "inline"
        },
        {
          "command": "vscode-diff-mcp.reject",
          "when": "view == pendingAiChanges && viewItem == pendingChange",
          "group": "inline"
        },
        {
          "command": "vscode-diff-mcp.openDiff",
          "when": "view == pendingAiChanges && viewItem == pendingChange",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "fastest-levenshtein": "^1.0.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
